{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pebble",
  "version": "0.1.1",
  "identifier": "com.coredevices.pebble.desktop",
  "build": {
    "devUrl": "http://localhost:3017",
    "frontendDist": "https://index.repebble.com"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "capabilities": [
        "index-production"
      ]
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZFQjBCOTQwMjczMTdCRgpSV1MvRjNNQ2xBdnJCZ1lhNUltNHRVc0lwUlFRaVdaTTlrOWZhYVA2YzV1VGhPSUtqOE5ldlVoQgo=",
      "endpoints": [
        "https://dash.repebble.com/api/desktop/update/{{target}}/{{arch}}/{{current_version}}"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "category": "Productivity",
    "shortDescription": "Pebble Index and iMessage setup for your Mac",
    "icon": [
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": "-",
      "entitlements": "Entitlements.plist"
    }
  }
}
